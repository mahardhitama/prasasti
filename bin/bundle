#!/bin/sh
# Builds target/Prasasti.app (ad-hoc signed), a link to the bundle in
# target/bundle.noindex: Spotlight skips .noindex, so the build copy stays out of Open With.
set -e
cd "$(dirname "$0")/.."
cargo build --release -p prasasti

app=target/bundle.noindex/Prasasti.app
rm -rf "$app" target/Prasasti.app
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources/Fonts"
cp target/release/prasasti "$app/Contents/MacOS/prasasti"
cp packaging/Info.plist "$app/Contents/Info.plist"
cp resources/fonts/* "$app/Contents/Resources/Fonts/"
# -L: preview/fonts links to resources/fonts; the bundle gets real copies.
cp -RL resources/preview "$app/Contents/Resources/preview"

# Icon: sips renders the SVG at each size, iconutil packs the set.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
set_dir="$tmp/prasasti.iconset"
mkdir "$set_dir"
for s in 16 32 128 256 512; do
    d=$((s * 2))
    sips -s format png -z $s $s resources/prasasti.svg --out "$set_dir/icon_${s}x${s}.png" >/dev/null
    sips -s format png -z $d $d resources/prasasti.svg --out "$set_dir/icon_${s}x${s}@2x.png" >/dev/null
done
iconutil -c icns "$set_dir" -o "$app/Contents/Resources/prasasti.icns"

codesign -s - --force "$app"
ln -s bundle.noindex/Prasasti.app target/Prasasti.app
# Keep the build copy out of Open With; the installed copy is the one to list.
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -u "$app" 2>/dev/null || true
echo "built target/Prasasti.app"
