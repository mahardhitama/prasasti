#!/bin/sh
# Accessibility smoke test: drives the real target/Prasasti.app through
# System Events (open, type, autosave, external change, quit).
# Needs Accessibility permission for the terminal. Exit 0 = all ok,
# 1 = a check failed (named in the output), 2 = no permission.
set -e
cd "$(dirname "$0")/.."

if pgrep -x prasasti >/dev/null; then
    echo "bin/smoke: Praśasti is already running; quit it first (the smoke run must own its instance)." >&2
    exit 1
fi

bin/bundle >/dev/null

drafts="$HOME/Library/Autosave Information"
state="$(getconf DARWIN_USER_TEMP_DIR)com.mahardhitama.prasasti.savedState"
[ -e "$state" ] && state_existed=1 || state_existed=
tmp=$(mktemp -d)
before="$tmp/drafts-before"
pidfile="$tmp/pid"
ls -A "$drafts" >"$before" 2>/dev/null || [ ! -e "$drafts" ] || rm -f "$before"
cleanup() {
    trap - EXIT INT TERM # exactly once, even when a signal is followed by EXIT
    # Only the instance this run launched (the JXA records its pid).
    pid=$(cat "$pidfile" 2>/dev/null || true)
    if [ -n "$pid" ] && [ "$(ps -p "$pid" -o comm= 2>/dev/null | sed 's|.*/||')" = prasasti ]; then
        kill "$pid" 2>/dev/null || true
    fi
    # Our own drafts for note.md (named "<displayName> (Autosaved <id>).md"), and
    # only those absent from the snapshot. No readable snapshot: delete nothing.
    if [ -r "$before" ]; then
        ls -A "$drafts" 2>/dev/null | while IFS= read -r f; do
            case "$f" in 'note.md (Autosaved '*').md') ;; *) continue ;; esac
            rc=0; grep -qxF -- "$f" "$before" || rc=$?
            [ "$rc" -eq 1 ] && rm -f "$drafts/$f" # 1 = not in the snapshot; 2 = error: keep
        done || true
    fi
    # The state -ApplePersistenceIgnoreState writes, unless it predates us.
    [ -n "$state_existed" ] || rm -rf "$state"
    rm -rf "$tmp"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

mkdir "$tmp/notes"
note="$tmp/notes/note.md"
printf '# Smoke\n' >"$note"

osascript -l JavaScript - "$PWD/target/Prasasti.app" "$note" "$pidfile" <<'JXA'
ObjC.import('Foundation'); ObjC.import('stdlib')
function run(argv) {
    const [appPath, note, pidfile] = argv
    const se = Application('System Events')
    const sh = Application.currentApplication()
    sh.includeStandardAdditions = true

    if (!se.uiElementsEnabled()) {
        console.log('bin/smoke needs Accessibility permission for this terminal: System Settings > Privacy & Security > Accessibility')
        $.exit(2)
    }

    const q = s => "'" + s.replace(/'/g, "'\\''") + "'"
    const wait = (secs, f) => {
        for (const end = Date.now() + secs * 1000; Date.now() < end; delay(0.1)) {
            try { const v = f(); if (v) return v } catch (e) {}
        }
        return null
    }
    const check = (name, ok) => {
        console.log('smoke ' + name + ' ... ' + (ok ? 'ok' : 'FAILED'))
        if (!ok) $.exit(1)
    }
    const disk = () => $.NSString.stringWithContentsOfFileEncodingError(note, $.NSUTF8StringEncoding, null).js
    const proc = () => se.processes.byName('prasasti')
    const win = () => proc().windows.byName('note.md')
    // Keys go to the frontmost app: never send them unless it is ours.
    const front = () => wait(1, () => { proc().frontmost = true; delay(0.05); return proc().frontmost() })
    const keys = (name, f) => { if (!front()) check(name + ' (Praśasti not frontmost, no keys sent)', false); f() }

    // Ignore saved windows from earlier runs; an argument, not a defaults write.
    sh.doShellScript('open -a ' + q(appPath) + ' ' + q(note) + ' --args -ApplePersistenceIgnoreState YES')
    // Recorded at once, so cleanup kills only this instance, even if interrupted.
    const pid = wait(5, () => proc().unixId())
    if (pid) $(String(pid)).writeToFileAtomicallyEncodingError(pidfile, true, $.NSUTF8StringEncoding, null)
    if (!wait(5, () => win().exists())) {
        // Usually an alert window ("could not be opened"): show its text.
        try { console.log(proc().windows.staticTexts.value().flat().join(' ')) } catch (e) {}
        check('open', false)
    }
    check('open', true)

    const ta = () => win().scrollAreas[0].textAreas[0]
    keys('type', () => {
        // A document read from a file opens in Preview; ⌘E switches to Edit.
        se.keystroke('e', { using: 'command down' })
        wait(2, () => ta().exists())
        ta().focused = true
        se.keyCode(125, { using: 'command down' }) // ⌘↓: end of text
        se.keystroke('hello')
    })
    check('type', wait(2, () => ta().value() === '# Smoke\nhello'))

    // autosavingDelay is 0, so AppKit's own in-place schedule applies: the
    // write lands ~15 s after the edit (measured), not within 10 s.
    check('autosave', wait(30, () => disk().includes('hello')))

    keys('external-change', () => se.keystroke('x'))
    wait(2, () => ta().value().endsWith('x'))
    sh.doShellScript("printf 'external\\n' > " + q(note))
    const sheet = wait(5, () => {
        const s = win().sheets[0]
        return s.buttons.byName('Reload').exists() && s.buttons.byName('Keep Mine').exists() && s
    })
    check('external-change sheet', sheet)
    sheet.buttons.byName('Reload').click()
    check('external-change reload', wait(5, () => ta().value() === 'external\n'))

    keys('quit', () => se.keystroke('q', { using: 'command down' }))
    check('quit', wait(5, () => !proc().exists()))
}
JXA
